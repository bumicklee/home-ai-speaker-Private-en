<?xml version="1.0" encoding="utf-8"?>
<!-- The speaker LAN API is plain HTTP (design document Section 2.14). Private IP ranges can't be expressed with domain-config, so they're allowed in base-config -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
