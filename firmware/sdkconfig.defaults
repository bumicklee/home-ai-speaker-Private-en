# Design document Section 2.17. All important settings live here (sdkconfig is not committed)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Allocate Wi-Fi and lwIP buffers from PSRAM first (internal RAM shortage, real board 2026-10-03)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# The option above raises the default Wi-Fi buffer counts (static RX 16, static TX 16). Pin them lower.
# (Dynamic TX can't be chosen in this mode: Kconfig depends on !SPIRAM_TRY_ALLOCATE_WIFI_LWIP)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
# On the S3, IRAM and DRAM share the same SRAM. Keep Wi-Fi code out of IRAM to grow the heap
# (throughput drops a little, but it's plenty for 128kbps radio and voice conversation)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Run code and constants from PSRAM (XIP). The cache stays on during flash operations, so tasks
# with PSRAM stacks can read and write NVS too → move task stacks to PSRAM to save internal RAM (Chapter 7, Section 7.3)
# Cost: about 2.2MB of PSRAM (out of 8MB), copy time at boot
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# (Under review) cache settings to improve wake word performance — after measuring the effect and memory use
# CONFIG_ESP32S3_DATA_CACHE_64KB=y
# CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Partitions (Section 2.16)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# TLS / WebSocket
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y

# Wake word models
CONFIG_SR_WN_WN9_ALEXA=y
CONFIG_SR_WN_WN9_COMPUTER_TTS=y

# Plaintext NVS for secrets: encryption off (if left on, an HMAC key is written to eFuse automatically)
CONFIG_NVS_ENCRYPTION=n

# BLE (led-app baseline + security). Bonds aren't stored, so NVS_PERSIST stays at the default (n)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# App rollback, signed OTA (no eFuse, Section 2.18)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# Signed with an RSA-3072 key at build time. The key is in ../certificates/ (not in Git, Chapter 1, Section 1.4.9)
# Without the key, the build fails.
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="../certificates/ota_signing_key.pem"

# HTTP server
CONFIG_HTTPD_WS_SUPPORT=y

# Logging: build in only up to INFO (so the HTTP client never prints URLs or headers, Section 2.2)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# FreeRTOS timer task: Wi-Fi reconnect and DHCP watchdog callbacks call esp_wifi_* and logging.
# The default 2KB overflowed (real board 2026-10-03, Tmr Svc stack overflow)
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# Watchdog: reboot if stuck (SYS-10)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# Console: UART0 primary + USB-Serial-JTAG secondary
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# mDNS task and memory to PSRAM as well (safe thanks to XIP, Chapter 7, Section 7.3)
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# Socket budget (Section 2.14): httpd 7 + TLS 3 + mDNS, SNTP, etc.
CONFIG_LWIP_MAX_SOCKETS=16
# Hardware AES borrows a temporary (DMA) buffer in internal RAM when it processes PSRAM data. When radio, conversation, and tools use TLS together,
# it couldn't borrow that buffer and connections dropped with "esp-aes: Failed to allocate memory" (Chapter 14, Bug 5; Chapter 18, Failure C).
# Software AES needs no temporary buffer in internal RAM (it uses a little more CPU, plenty for this device's traffic)
# CONFIG_MBEDTLS_HARDWARE_AES is not set
