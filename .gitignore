# macOS
.DS_Store

# Secrets: never commit the OTA signing key (Section 1.4.9 of the book). The folder stays via .gitkeep
certificates/*.pem
*.pem

# ESP-IDF build output
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/

# Flutter build output (other entries are in flutter/.gitignore)
flutter/build/

# Release build artifacts (scripts/build-flutter-release.sh)
releases/

# Tool state
.bkit/

# Personal settings: keep them out of the repository (Chapter 2 of the book)
.claude/settings.local.json
.claude/worktrees/
.vscode/
.idea/
*.swp
Thumbs.db

# Android signing and local settings (in case you create a key for store release)
flutter/android/key.properties
flutter/android/local.properties
*.jks
*.keystore

# Environment variable and secret files
.env
.env.*
